        <ui:TextBox TextWrapping="Wrap" Text="Status: Disconnected" Width="500" Background="#0FFFFFFF" Foreground="Black" FontSize="36" TextAlignment="Center" Margin="0,10,0,0" FontFamily="Segoe UI Black">
